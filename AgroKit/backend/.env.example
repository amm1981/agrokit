PORT=8081
NODE_ENV=development
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=agrokit
MYSQL_USER=agrokit_app
MYSQL_PASSWORD=
MYSQL_CONNECTION_LIMIT=10

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_Y_SEGURO
JWT_ISSUER=agrokit-backend
JWT_AUDIENCE=agrokit-system
JWT_EXPIRATION_HOURS=8
PDA_ALLOW_CATALOG_WRITES=false

EVIDENCE_MAX_BYTES=8388608
EVIDENCE_STORAGE_DRIVER=local
EVIDENCE_STORAGE_DIR=./storage/evidencias

# Local: URL publica base para evidencias. Si no se define, se responde /evidencias/<path>.
# EVIDENCE_PUBLIC_BASE=http://localhost:8081/evidencias

# Produccion S3 compatible (Contabo Object Storage)
# EVIDENCE_STORAGE_DRIVER=s3
# S3_ENDPOINT=https://usc1.contabostorage.com
# S3_BUCKET=agrokit-files
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_BASE_URL=https://usc1.contabostorage.com/agrokit-files
